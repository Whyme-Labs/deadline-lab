set(CMAKE_SYSTEM_NAME QNX)
if(NOT DEFINED ENV{QNX_HOST} OR NOT DEFINED ENV{QNX_TARGET})
  message(FATAL_ERROR "Source the licensed QNX SDK environment before configuring")
endif()
find_program(QCC qcc REQUIRED)
set(DL_QNX_VARIANT "gcc_ntox86_64" CACHE STRING "Variant listed by qcc -V")
set(CMAKE_C_COMPILER "${QCC}")
set(CMAKE_C_COMPILER_ARG1 "-V${DL_QNX_VARIANT}")
set(CMAKE_TRY_COMPILE_TARGET_TYPE STATIC_LIBRARY)
